# Calibration locks hash these source files with CRLF line endings.
/*.py text eol=crlf
/src/**/*.py text eol=crlf
/scripts/**/*.py text eol=crlf
/pyproject.toml text eol=crlf
/requirements*.txt text eol=crlf
/configs/plan.json text eol=crlf

# Keep each frozen detector configuration in the format recorded by its lock.
/configs/detector_calibrated.json text eol=lf
/configs/detector_stage56.json text eol=lf
/configs/detector_stage78.json text eol=lf
/configs/detector_long_horizon_20261117.json text eol=crlf
/configs/detector_na.json text eol=lf
/configs/detector_na.lock.json text eol=lf

# Preserve the recorded bytes of the 10,000-second study artifacts.
/.wsn-foundation-10000s/** -text
/results/csv/simulation_log_* -text
/results/security_audit/validation_gate.json text eol=crlf
/results/backup/** -text
/results/kiem-chung/** -text
/results/runs/** -text
/results/security_audit/archive/** -text
/results/published-10000s-na/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/results/published-10000s-na/security/figures/*.svg -whitespace
